\f0\fs21\fsmilli10800 \cf0 \'a7. 135.\cb1 \uc0\u8232 \u8232 \u8232 \cb2 Negatione posita realitas tollitur, \'a7. 36, 10. Hinc negationes et realitates sunt sibi invicem oppositae, \'a7. 81. Tam realitates ipsae, quam entia, quibus insunt, entia realia{\field{\*\fldinst{HYPERLINK "http://pm.nlx.com.proxy.uchicago.edu/xtf/view?docId=kant_de/kant_de.14.xml;chunk.id=div.kant.Bd.XVII.20;toc.id=div.kant.Bd.XVII.20;brand=default#kant.nach.844fm"}}{\fldrslt \cf5 \super \strokec5 *}}) seu positiva dicuntur. Negationes autem entia negativa{\field{\*\fldinst{HYPERLINK "http://pm.nlx.com.proxy.uchicago.edu/xtf/view?docId=kant_de/kant_de.14.xml;chunk.id=div.kant.Bd.XVII.20;toc.id=div.kant.Bd.XVII.20;brand=default#kant.nach.843fm"}}{\fldrslt \cf5 \super \strokec5 **}}).\
\pard\pardeftab720\partightenfactor0
{\field{\*\fldinst{HYPERLINK "http://pm.nlx.com.proxy.uchicago.edu/xtf/view?docId=kant_de/kant_de.14.xml;chunk.id=div.kant.Bd.XVII.20;toc.id=div.kant.Bd.XVII.20;brand=default#kant.nach.844tm"}}{\fldrslt \cf5 \super \strokec5 *}}) etwas bejahendes.\
\pard\pardeftab720\partightenfactor0
{\field{\*\fldinst{HYPERLINK "http://pm.nlx.com.proxy.uchicago.edu/xtf/view?docId=kant_de/kant_de.14.xml;chunk.id=div.kant.Bd.XVII.20;toc.id=div.kant.Bd.XVII.20;brand=default#kant.nach.843tm"}}{\fldrslt \cf5 \super \strokec5 **}}) etwas verneinendes.\
