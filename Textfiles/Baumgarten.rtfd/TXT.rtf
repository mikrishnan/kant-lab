\f1 \ulnone \'a0SECTIO III.\cb1 \uc0\u8232 \cb2 ORIGO ANIMAE HUMANAE.\
\pard\pardeftab720\qc\partightenfactor0

\f0\fs21\fsmilli10800 \cf0 \'a7. 770.\cb1 \uc0\u8232 \u8232 \u8232 \cb2 Dum homo concipitur, anima in artissimo commercio futura cum eius corpore, quale in his terris hominibus est, aut iam praeexstitit, aut in ipsa conceptione, aut paullo post eam exsistere demum incipit. Qui primum ponit, praeexsistentianus{\field{\*\fldinst{HYPERLINK "http://pm.nlx.com.proxy.uchicago.edu/xtf/view?docId=kant_de/kant_de.14.xml;chunk.id=div.kant.Bd.XVII.55;toc.id=div.kant.Bd.XVII.55;brand=default#kant.nach.446fm"}}{\fldrslt \cf5 \super \strokec5 *}}) vocatur.\
\pard\pardeftab720\partightenfactor0
{\field{\*\fldinst{HYPERLINK "http://pm.nlx.com.proxy.uchicago.edu/xtf/view?docId=kant_de/kant_de.14.xml;chunk.id=div.kant.Bd.XVII.55;toc.id=div.kant.Bd.XVII.55;brand=default#kant.nach.446tm"}}{\fldrslt \cf5 \super \strokec5 *}}) ein Freund des Vorherdaseins.\
\pard\pardeftab720\qc\partightenfactor0
\cf4 \super \strokec4 [311]\cf0 \nosupersub \strokec3 \'a0\'a7. 771.\
\pard\pardeftab720\partightenfactor0
\cf0 In ipsa conceptione, aut paullo post eam, incipere demum exsistentiam animae humanae qui ponunt, aut eam ex parentibus oriri volunt et traduciani{\field{\*\fldinst{HYPERLINK "http://pm.nlx.com.proxy.uchicago.edu/xtf/view?docId=kant_de/kant_de.14.xml;chunk.id=div.kant.Bd.XVII.55;toc.id=div.kant.Bd.XVII.55;brand=default#kant.nach.445fm"}}{\fldrslt \cf5 \super \strokec5 *}}) vocantur, aut eam admittunt tunc primum exsistentem ex nihilo, et dicuntur induciani{\field{\*\fldinst{HYPERLINK "http://pm.nlx.com.proxy.uchicago.edu/xtf/view?docId=kant_de/kant_de.14.xml;chunk.id=div.kant.Bd.XVII.55;toc.id=div.kant.Bd.XVII.55;brand=default#kant.nach.444fm"}}{\fldrslt \cf5 \super \strokec5 **}}) (infusiani, coexsistentiani).\
\pard\pardeftab720\partightenfactor0
{\field{\*\fldinst{HYPERLINK "http://pm.nlx.com.proxy.uchicago.edu/xtf/view?docId=kant_de/kant_de.14.xml;chunk.id=div.kant.Bd.XVII.55;toc.id=div.kant.Bd.XVII.55;brand=default#kant.nach.445tm"}}{\fldrslt \cf5 \super \strokec5 *}}) ein Freund des Ursprungs durch den \'dcbergang.\
\pard\pardeftab720\partightenfactor0
{\field{\*\fldinst{HYPERLINK "http://pm.nlx.com.proxy.uchicago.edu/xtf/view?docId=kant_de/kant_de.14.xml;chunk.id=div.kant.Bd.XVII.55;toc.id=div.kant.Bd.XVII.55;brand=default#kant.nach.444tm"}}{\fldrslt \cf5 \super \strokec5 **}}) ein Freund der augenblicklichen Sch\'f6pfung.\
\pard\pardeftab720\qc\partightenfactor0
\cf0 \'a7. 772.\
\pard\pardeftab720\partightenfactor0
\cf0 Qui animam humanam ponit actuatam ex nihilo, creatianus{\field{\*\fldinst{HYPERLINK "http://pm.nlx.com.proxy.uchicago.edu/xtf/view?docId=kant_de/kant_de.14.xml;chunk.id=div.kant.Bd.XVII.55;toc.id=div.kant.Bd.XVII.55;brand=default#kant.nach.443fm"}}{\fldrslt \cf5 \super \strokec5 *}}) appellatur. Hinc inducianus est creatianus, \'a7. 771. Praeexsistentianus potest esse creatianus, \'a7. 770. Traducianus non est creatianus, et v.v., \'a7. 771. Traduciani sive ex parentum anima, ut flammulam ex flammula, sive ex eorundem corpore, derivent oriundam animam, aut oriri animam novam admittere tenentur ex parte parentum simplici, aut ex composita, \'a7. 224. Si prius: anima non oritur, sed praeexsistit, \'a7. 227; si posterius: anima nova non erit monas, sed compositum stricte dictum, \'a7. 225, quod contra \'a7. 756,\cb1 \uc0\u8232 \cb2 757. Anima non potest oriri, nisi ex nihilo, \'a7. 745. Ergo non oritur ex parentibus, \'a7. 228.\
\pard\pardeftab720\partightenfactor0
{\field{\*\fldinst{HYPERLINK "http://pm.nlx.com.proxy.uchicago.edu/xtf/view?docId=kant_de/kant_de.14.xml;chunk.id=div.kant.Bd.XVII.55;toc.id=div.kant.Bd.XVII.55;brand=default#kant.nach.443tm"}}{\fldrslt \cf5 \super \strokec5 *}}) ein Freund der unmittelbaren Sch\'f6pfung.\
\pard\pardeftab720\qc\partightenfactor0
