{\field{\*\fldinst{HYPERLINK "http://pm.nlx.com.proxy.uchicago.edu/xtf/view?docId=kant_de/kant_de.14.xml;chunk.id=div.kant.Bd.XVII.27;toc.id=div.kant.Bd.XVII.27;brand=default#kant.nach.739tm"}}{\fldrslt \cf5 \super \strokec5 *}}) neben einander seiende.\
