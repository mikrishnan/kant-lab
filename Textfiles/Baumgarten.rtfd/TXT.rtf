\'a7. 803.\cb1 \uc0\u8232 \u8232 \u8232 \cb2 Ens perfectissimum{\field{\*\fldinst{HYPERLINK "http://pm.nlx.com.proxy.uchicago.edu/xtf/view?docId=kant_de/kant_de.14.xml;chunk.id=div.kant.Bd.XVII.61;toc.id=div.kant.Bd.XVII.61;brand=default#kant.nach.407fm"}}{\fldrslt \cf5 \super \strokec5 *}}) est, cui summa in entibus est perfectio: i.e. in quo tot, tanta, tantum in tot et tanta consentiunt, quot, quanta, quantum in plurima et maxima possibilium in ullo ente consentire possunt, \'a7. 185. Est ergo in ente perfectissimo quaedam pluralitas absolute necessario, \'a7. 74.\
\pard\pardeftab720\partightenfactor0
\cf0 \
\pard\pardeftab720\partightenfactor0
{\field{\*\fldinst{HYPERLINK "http://pm.nlx.com.proxy.uchicago.edu/xtf/view?docId=kant_de/kant_de.14.xml;chunk.id=div.kant.Bd.XVII.61;toc.id=div.kant.Bd.XVII.61;brand=default#kant.nach.407tm"}}{\fldrslt \cf5 \super \strokec5 *}}) das vollkommenste.\
\pard\pardeftab720\qc\partightenfactor0
\cf0 \'a7. 804.\
\pard\pardeftab720\partightenfactor0
\cf0 Praedicata entis perfectissimi dicuntur eius perfectiones. In ente perfectissimo tot sunt perfectiones plurimum consentientes, quot in ente simul esse possunt, quot sunt compossibiles, \'a7. 803.\
\pard\pardeftab720\qc\partightenfactor0
\cf0 \'a7. 805.\
\pard\pardeftab720\partightenfactor0
\cf0 Omnis entis perfectissimi perfectio tanta est, quanta ullo in ente esse potest, \'a7. 803, 804.\
\pard\pardeftab720\qc\partightenfactor0
\cf4 \super \strokec4 [331]\cf0 \nosupersub \strokec3 \'a0\'a7. 806.\
\pard\pardeftab720\partightenfactor0
\cf0 Ens perfectissimum est ens reale, \'a7. 803, 135. Ergo illi convenit realitas tanta, quanta in ente esse potest. Ens perfectissimum est realissimum, \'a7. 805, 804, in quo plurimae maximae realitates, summum bonum et optimum metaphysice, \'a7. 190.\
\pard\pardeftab720\qc\partightenfactor0
\cf0 \'a7. 807.\
\pard\pardeftab720\qc\partightenfactor0

