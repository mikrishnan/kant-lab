\cf0 \'a7. 240.\
\pard\pardeftab720\partightenfactor0
\cf0 Positis simultaneis extra se, ponitur spatium. Posito spatio extra se invicem ponuntur simultanea. Positis successivis, ponitur tempus, et posito tempore po|nuntur\'a0\cf4 \super \strokec4 [72]\cf0 \nosupersub \strokec3 \'a0diversa,\cb1 \uc0\u8232 \cb2 \'a7. 74, sibi succedentia, \'a7. 239, 78.\
\pard\pardeftab720\qc\partightenfactor0
\cf0 \'a7. 241.\
\pard\pardeftab720\partightenfactor0
