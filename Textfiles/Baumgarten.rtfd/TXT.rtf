{\field{\*\fldinst{HYPERLINK "http://pm.nlx.com.proxy.uchicago.edu/xtf/view?docId=kant_de/kant_de.14.xml;chunk.id=div.kant.Bd.XVII.13;toc.id=div.kant.Bd.XVII.13;brand=default#kant.nach.923tm"}}{\fldrslt \cf5 \super \strokec5 *}}) ein Unding.\
\pard\pardeftab720\partightenfactor0
{\field{\*\fldinst{HYPERLINK "http://pm.nlx.com.proxy.uchicago.edu/xtf/view?docId=kant_de/kant_de.14.xml;chunk.id=div.kant.Bd.XVII.13;toc.id=div.kant.Bd.XVII.13;brand=default#kant.nach.922tm"}}{\fldrslt \cf5 \super \strokec5 **}}) ein erdichtetes Ding.\
\pard\pardeftab720\qc\partightenfactor0
\cf0 \'a7. 63.\
\pard\pardeftab720\partightenfactor0
\cf0 Omne ens est possibile, \'a7. 61, rationem, \'a7. 20, sufficientem habet, \'a7. 22, et rationatum, \'a7. 23, hinc dupliciter connexum est, \'a7. 24, habet essentiam, \'a7. 53, et essentialia, \'a7. 40, hinc affectiones, \'a7. 43, in universali nexu, \'a7. 49. Omnes entis determinationes aut sunt essentialia, aut attributa, aut modi, aut relationes, \'a7. 52. Posito ente, ponitur essentia eius, hinc essentialia omnia. Sublata essentia, tollitur ens. Sublato essentiali, tollitur essentia, hinc ens ipsum, \'a7. 53,\cb1 \uc0\u8232 \cb2 40. Omnis denique determinatio entis interna aut pertinet ad essentiam eius, aut ad exsistentiam, \'a7. 56.\
\pard\pardeftab720\qc\partightenfactor0
\cf4 \super \strokec4 [18]\cf0 \nosupersub \strokec3 \'a0\'a7. 64.\
\pard\pardeftab720\qc\partightenfactor0

