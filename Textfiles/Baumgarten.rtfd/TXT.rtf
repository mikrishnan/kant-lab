\cf0 Ordo simultaneorum extra se invicem positorum est spatium{\field{\*\fldinst{HYPERLINK "http://pm.nlx.com.proxy.uchicago.edu/xtf/view?docId=kant_de/kant_de.14.xml;chunk.id=div.kant.Bd.XVII.27;toc.id=div.kant.Bd.XVII.27;brand=default#kant.nach.737fm"}}{\fldrslt \cf5 \super \strokec5 *}}), successivorum tempus{\field{\*\fldinst{HYPERLINK "http://pm.nlx.com.proxy.uchicago.edu/xtf/view?docId=kant_de/kant_de.14.xml;chunk.id=div.kant.Bd.XVII.27;toc.id=div.kant.Bd.XVII.27;brand=default#kant.nach.736fm"}}{\fldrslt \cf5 \super \strokec5 **}}).\
