\f0\fs21\fsmilli10800 \cf0 SECTIO I.\cb1 \uc0\u8232 \cb2 PARTES UNIVERSI SIMPLICES.\
\'a7. 392.\cb1 \uc0\u8232 \u8232 \u8232 \cb2 Omnis mundus aut est ens simplex, aut compositum, \'a7. 224, hic est ens compositum. Qui hunc mundum se putat ens simplex est egoista.\
\'a7. 393.\
\pard\pardeftab720\partightenfactor0
\cf0 Mundi compositi partes singulae et simul sumptae non possunt esse accidentia. Cum enim exsistere talis mundus non posset, nisi in substantiis, \'a7. 155, 191, nec posset tamen infinitae inhaerere, \'a7. 388, nec unicae finitae, \'a7. 224, 194, requireret plures substantias finitas, quibus inhaereret, \'a7. 77. At hae constituerent seriem finitorum actualium, quae si non esset pars mundi ex meris accidentibus compositi,\'a0\cf4 \super \strokec4 [124]\cf0 \nosupersub \strokec3 \'a0cum ipso tamen constitueret seriem finitorum actualium ipso maiorem, \'a7. 160, hinc ipse non esset mundus, \'a7. 354. Si series illa, quam substantiae finitae constituerent, esset pars eius mundi, non esset ille ex meris accidentibus compositus, \'a7. 155. Hinc impossibilis est mundus ex meris accidentibus compositus, \'a7. 61, 62. Omnis mundus compositus est compositum strictius dictum, \'a7. 225. Omnis mundus aut est substantia, \'a7. 389,\cb1 \uc0\u8232 \cb2 392, aut compositum strictius dictum.\
\pard\pardeftab720\qc\partightenfactor0
\cf0 \'a7. 394.\
\pard\pardeftab720\partightenfactor0
\cf0 Partes mundi compositi sunt vel substantiales, vel accidentales, \'a7. 393, et illae quidem monades, \'a7. 235. Hinc omnis mundus compositus, et hic monadibus constat, \'a7. 392. Unde denuo patet, nullum mundum oriri posse, nisi ex nihilo, \'a7. 236, nec interire, nisi per annihilationem, \'a7. 237,\cb1 \uc0\u8232 \cb2 393.\
\pard\pardeftab720\qc\partightenfactor0
\cf0 \'a7. 395.\
\pard\pardeftab720\qc\partightenfactor0

