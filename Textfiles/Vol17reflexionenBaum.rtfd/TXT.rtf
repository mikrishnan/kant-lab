\f3\i \cf4 \strokec4 bricht ab
\f1\i0 .\cf0 \cb1 \strokec3 \uc0\u8232 \cb2 \
\pard\pardeftab720\qc\partightenfactor0
\cf0 __________\
\pard\pardeftab720\partightenfactor0

