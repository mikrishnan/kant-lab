{\field{\*\fldinst{HYPERLINK "http://pm.nlx.com.proxy.uchicago.edu/xtf/view?docId=kant_de/kant_de.13.xml;chunk.id=div.kant.Bd.XVI.70;toc.id=div.kant.Bd.XVI.70;brand=default#kant.nach.1008tm"}}{\fldrslt \cf5 \super \strokec5 *}}(
