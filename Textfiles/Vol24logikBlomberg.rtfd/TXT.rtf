\f3\b \cf0 Der | Sechste Abschnitt | \uc0\u8232 Von der Gewi\'dfheit | der | Gelehrten Erkenntni\'df
\f0\b0 \
\pard\pardeftab720\qc\partightenfactor0

\fs28\fsmilli14300 \cf0 \uc0\u8213  xxiv.142u \u8213  \
\pard\pardeftab720\partightenfactor0

\fs21\fsmilli10725 \cf4 \cb5 \super [431]
\fs28\fsmilli14400 \cf0 \cb1 \nosupersub \
\
